# ==============================================================================
# OPÇÃO 1 (MAIS RECOMENDADA E SIMPLES): VERCEL KV / UPSTASH REDIS
# ==============================================================================
# Na Vercel, basta ir na aba "Storage" do seu projeto, clicar em "Create Database"
# e selecionar "KV" (ou Upstash Redis no Marketplace). 
# A Vercel adiciona essas variáveis AUTOMATICAMENTE ao seu deploy, sem precisar copiar nada!
#
# Se quiser rodar localmente apontando para o Redis da Vercel/Upstash:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Ou se usar a integração direta da Upstash na Vercel:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# OPÇÃO 2: TURSO / LIBSQL (SQLITE SERVERLESS - ALTERNATIVA)
# ==============================================================================
# Para desenvolvimento local via arquivo SQLite local:
# TURSO_DATABASE_URL="file:local.db"
#
# Para produção via Turso Cloud:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ==============================================================================
# NOTA:
# Se nenhuma das opções acima for configurada, a aplicação continua funcionando
# normalmente no modo local/offline (localStorage + memória no navegador).
# ==============================================================================
