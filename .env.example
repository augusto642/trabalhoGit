# ==============================================================================
# OPÇÃO 1 (MAIS RECOMENDADA E SIMPLES): VERCEL KV / UPSTASH REDIS
# ==============================================================================
# Na Vercel, basta ir na aba "Storage" do seu projeto, clicar em "Create Database"
# e selecionar "KV" (ou Upstash Redis no Marketplace). 
# A Vercel adiciona essas variáveis AUTOMATICAMENTE ao seu deploy, sem precisar copiar nada!
#
# Se quiser rodar localmente apontando para o Redis da Vercel/Upstash:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Ou se usar a integração direta da Upstash na Vercel:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# OPÇÃO 2: TURSO / LIBSQL (SQLITE SERVERLESS - ALTERNATIVA)
# ==============================================================================
# Para desenvolvimento local via arquivo SQLite local:
# TURSO_DATABASE_URL="file:local.db"
#
# Para produção via Turso Cloud:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ==============================================================================
# NOTA:
# Se nenhuma das opções acima for configurada, a aplicação continua funcionando
# normalmente no modo local/offline (localStorage + memória no navegador).
# ==============================================================================

# ==============================================================================
# SENHA DO PROFESSOR (somente o reset: /api/reset — as escritas do fluxo
# do aluno, /api/students, /api/repository, /api/logs e /api/git/push, NÃO
# exigem esta senha; a proteção delas é a validação de schema)
# ==============================================================================
# O reset exige o header `x-teacher-password` com exatamente este valor.
# Sem ele, ninguém apaga a turma via API.
# - Se a variável estiver definida: header ausente/errado -> 401.
# - Se NÃO estiver definida e NODE_ENV=production: reset -> 503
#   (fail-closed: produção sem senha não apaga a turma).
# - Se NÃO estiver definida fora de produção: reset liberado, para não
#   quebrar o fluxo local de aula/teste.
# Como gerar um valor: use um gerador de senhas (ex.: `openssl rand -hex 32`)
# e cole o resultado aqui e na configuração do deploy. NUNCA commite o
# arquivo .env real nem compartilhe a senha com os alunos.
TEACHER_PASSWORD="sua-senha-forte-aqui"
