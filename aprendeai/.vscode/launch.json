{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Executar AprendeAI (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "stopOnEntry": false,
      "timeout": 30000
    }
  ]
}
